
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Library Hub</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-layout">

        <aside class="sidebar">
            <a class="brand" asp-controller="Home"
               asp-action="Index">Nickzz Library</a>

            <nav>
                <a class="side-link" asp-controller="Home"
                   asp-action="Index">Dashboard</a>

                <a class="side-link" asp-controller="Members"
                   asp-action="Index">Members</a>

                <a class="side-link" asp-controller="Books"
                   asp-action="Index">Books</a>
            </nav>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <h2>@ViewData["Title"]</h2>
            </header>

            <section class="page-content">
                @RenderBody()
            </section>
        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
